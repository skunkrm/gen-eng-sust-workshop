# Copia questo file in .env e inserisci la tua chiave del Generative Engine
# (Studio -> My API Keys and Usage). Non condividere mai il file .env.
GEN_ENGINE_API_KEY=inserisci-qui-la-tua-chiave

# Endpoint: di default quello US. Per tenere i dati in Europa (o se il budget US è finito)
# usa l'endpoint EU: commenta la riga US e togli il # dalla riga EU.
GEN_ENGINE_BASE_URL=https://openai.generative.engine.capgemini.com/v1
# GEN_ENGINE_BASE_URL=https://openai.generative-eu.engine.capgemini.com/v1
